# Site Config
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MySQL Database Configuration (mysql2)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=quickcar_db

# Or use standard DATABASE_URL connection string:
DATABASE_URL="mysql://root:@127.0.0.1:3306/quickcar_db"

# Google Maps API (Optional: Fallback pre-populated UK database is active if omitted)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Stripe Payments (For production live payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample_key
STRIPE_SECRET_KEY=sk_test_sample_key
STRIPE_WEBHOOK_SECRET=whsec_sample_key

# Email Notifications (SMTP / Resend / SendGrid / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Quick Car Midlands Ltd" <no-reply@quickcarmidlands.co.uk>
ADMIN_NOTIFICATION_EMAIL=admin@quickcarmidlands.co.uk
